# Copy to .env and fill in. Never commit .env. Stripe: test-mode keys only.

DATABASE_URI=            # Supabase → Connect → Session pooler URI (port 5432), with your DB password
PAYLOAD_SECRET=          # any random string, 32+ chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000   # on Vercel: https://<project>.vercel.app
STRIPE_SECRET_KEY=       # Stripe Dashboard (sandbox) → API keys → Secret key (sk_test_...)
STRIPE_WEBHOOK_SECRET=   # local: printed by `stripe listen --forward-to localhost:3000/next/stripe/webhook`; Vercel: Webhooks → endpoint → Signing secret
BLOB_READ_WRITE_TOKEN=   # Vercel → Storage → Blob store; leave empty locally (uploads go to ./media)